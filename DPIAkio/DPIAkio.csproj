<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DPIAkio</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>DPIAkio</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- Single-file release (build-release.ps1 sets PublishSingleFile=true).
       Everything (.NET, Windows App SDK, goodbyedpi + WinDivert) goes into one exe and is extracted
       to %TEMP%\.net\DPIAkio\<hash>\ on first launch, so nothing has to be installed. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- goodbyedpi.exe + WinDivert.dll + WinDivert64.sys, built by build-goodbyedpi.ps1 -->
    <None Include="..\bin\**\*" Link="goodbyedpi\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Visual Studio "Run" (F5) on a fresh clone: compile goodbyedpi first when ..\bin is empty.
       Needs WinDivert in ..\deps (see README). Items are added here because the glob above was
       evaluated before this target produced the files. -->
  <Target Name="BuildGoodbyeDpiIfMissing" BeforeTargets="AssignTargetPaths"
          Condition="!Exists('$(MSBuildProjectDirectory)\..\bin\goodbyedpi.exe')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\build-goodbyedpi.ps1&quot;" />
    <ItemGroup>
      <None Include="$(MSBuildProjectDirectory)\..\bin\**\*" Link="goodbyedpi\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
