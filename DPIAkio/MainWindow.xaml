<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DPIAkio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:DPIAkio.Services"
    Title="DPIAkio">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="Assets/app.ico" Width="16" Height="16" />
                <TextBlock Text="DPIAkio" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <TextBlock Text="GoodbyeDPI GUI" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="24,8,24,24">
            <StackPanel Spacing="12" MaxWidth="860">

                <InfoBar x:Name="MissingBar" Severity="Error" IsClosable="False" Title="Thiếu file GoodbyeDPI" />

                <!-- Status / power -->
                <Border Style="{StaticResource CardStyle}" Padding="24,20">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="56" Height="56">
                            <Ellipse x:Name="StatusRing" Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                            <FontIcon x:Name="StatusIcon" Glyph="&#xE7E8;" FontSize="24" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="StatusTitle" Text="Đã tắt" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="StatusDetail" Text="Bấm Bật để bắt đầu vượt DPI"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="PowerButton" Grid.Column="2" Style="{StaticResource AccentButtonStyle}"
                                MinWidth="120" Height="40" Click="PowerButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="PowerGlyph" Glyph="&#xE768;" FontSize="14" />
                                <TextBlock x:Name="PowerText" Text="Bật" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <InfoBar x:Name="RunningHint" Severity="Informational" IsClosable="False"
                         Message="Đang chạy — tắt rồi bật lại để đổi tùy chọn." />

                <ContentControl x:Name="OptionsHost" HorizontalContentAlignment="Stretch" IsTabStop="False">
                <StackPanel Spacing="12">
                <!-- Mode -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Chế độ" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ComboBox x:Name="ModeCombo" HorizontalAlignment="Stretch" SelectionChanged="Option_Changed" />
                        <TextBlock x:Name="ModeDesc" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />

                        <!-- Plain-language explanation of the selected mode and each of its flags -->
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="14,12">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Giải thích" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                                <TextBlock x:Name="ModeExplain" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <StackPanel x:Name="ModeFlagsPanel" Spacing="6" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- DNS -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Chuyển hướng DNS" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Nhà mạng chặn web chủ yếu bằng DNS giả. Chọn một DNS server bên dưới để goodbyedpi chuyển truy vấn sang đó."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="DnsToggle" Grid.Column="1" OnContent="Bật" OffContent="Tắt"
                                          MinWidth="0" VerticalAlignment="Top" Toggled="Option_Changed" />
                        </Grid>

                        <!-- Provider picker -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DnsSearchBox" PlaceholderText="Tìm theo tên hoặc IP…" TextChanged="DnsFilter_Changed" />
                            <ComboBox x:Name="DnsGroupCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="DnsFilter_Changed" />
                            <Button x:Name="ProbeAllButton" Grid.Column="2" Click="ProbeAll_Click"
                                    ToolTipService.ToolTip="Gửi thử truy vấn steamcommunity.com tới từng DNS, đo thời gian và phát hiện IP giả">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEC4A;" FontSize="14" />
                                    <TextBlock Text="Đo tốc độ" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ListView x:Name="DnsList" Height="340" SelectionMode="Single"
                                  BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="6"
                                  SelectionChanged="DnsList_SelectionChanged">
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Key}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="services:DnsProvider">
                                    <Grid Padding="0,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{x:Bind Name}" />
                                            <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Addresses}" FontFamily="Consolas" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind ProbeText, Mode=OneWay}"
                                                   Foreground="{x:Bind ProbeBrush, Mode=OneWay}"
                                                   VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock x:Name="DnsProbeStatus" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Mẹo: bấm Đo tốc độ khi goodbyedpi đang TẮT để kết quả chính xác." />

                        <!-- Active addresses (editable only for "Tùy chỉnh") -->
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="IPv4" VerticalAlignment="Center" MinWidth="100" />
                            <TextBox x:Name="DnsAddrBox" Grid.Column="1" PlaceholderText="77.88.8.8" VerticalAlignment="Center" TextChanged="Option_Changed" />
                            <NumberBox x:Name="DnsPortBox" Grid.Column="2" Minimum="1" Maximum="65535" PlaceholderText="Port"
                                       VerticalAlignment="Center" ValueChanged="NumberBox_Changed" />
                            <ToggleSwitch x:Name="DnsV6Toggle" Grid.Row="1" OnContent="IPv6" OffContent="IPv6" Toggled="Option_Changed" />
                            <TextBox x:Name="DnsV6AddrBox" Grid.Row="1" Grid.Column="1" PlaceholderText="2a02:6b8::feed:0ff" VerticalAlignment="Center" TextChanged="Option_Changed" />
                            <NumberBox x:Name="DnsV6PortBox" Grid.Row="1" Grid.Column="2" Minimum="1" Maximum="65535" PlaceholderText="Port"
                                       VerticalAlignment="Center" ValueChanged="NumberBox_Changed" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Advanced -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Nâng cao" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="BlacklistCheck" Content="Blacklist" Checked="Option_Changed" Unchecked="Option_Changed" />
                            <TextBox x:Name="BlacklistBox" Grid.Column="1" PlaceholderText="Chỉ áp dụng cho domain trong file .txt"
                                     VerticalAlignment="Center" TextChanged="Option_Changed" />
                            <Button Grid.Column="2" Content="Chọn file…" Click="BrowseBlacklist_Click" />
                        </Grid>
                        <TextBox x:Name="ExtraArgsBox" Header="Tham số thêm" PlaceholderText="vd: --frag-by-sni --fake-with-sni www.google.com"
                                 FontFamily="Consolas" TextChanged="Option_Changed" />
                        <CheckBox x:Name="AutoStartCheck" Content="Tự động bật khi mở app" Checked="Option_Changed" Unchecked="Option_Changed" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Lệnh sẽ chạy" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="10,8">
                                <TextBlock x:Name="CommandPreview" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                </StackPanel>
                </ContentControl>

                <!-- System (usable while running) -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Hệ thống" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Chạy cùng Windows" />
                                <TextBlock Text="Khi đăng nhập: mở DPIAkio ẩn dưới khay và bật GoodbyeDPI luôn, không hỏi UAC (Task Scheduler)."
                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" OnContent="Bật" OffContent="Tắt" MinWidth="0"
                                          VerticalAlignment="Center" Toggled="StartupToggle_Toggled" />
                        </Grid>
                        <CheckBox x:Name="CloseToTrayCheck" Content="Bấm X thì thu xuống khay (GoodbyeDPI vẫn chạy)"
                                  Checked="Option_Changed" Unchecked="Option_Changed" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Khi chơi game nên để app dưới khay: cửa sổ ẩn thì không vẽ lại, nhật ký ngừng cập nhật và RAM được trả lại cho hệ thống. Packet của game (UDP) không đi qua GoodbyeDPI nên không tăng ping." />
                    </StackPanel>
                </Border>

                <!-- Log -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="Nhật ký" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="Mở thư mục" Click="OpenFolder_Click" />
                                <Button Content="Xóa" Click="ClearLog_Click" />
                            </StackPanel>
                        </Grid>
                        <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 FontFamily="Consolas" FontSize="12" Height="220"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
